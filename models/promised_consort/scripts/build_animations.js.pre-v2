        {phase: 2, airborne: [[19, 50]], events: [28, 34, 40].map(tick => ({tick, kind: "clone"})).concat([{tick: 51, sword: "both"}]), energy: 1.7});
    make("lightspeed_dash", [frame(0), frame(9, "dash_load"), frame(24, "dash_load"), frame(26, "dash", 1, {linear: true}),
