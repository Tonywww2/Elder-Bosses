# Keep source diffs stable across Windows and Unix checkouts.
* text=auto eol=lf whitespace=cr-at-eol
*.bat text eol=crlf

# Preserve the exact bytes pinned by current asset manifests.
*.bbmodel -text
tools/**/*.json -text
src/main/resources/assets/elder_bosses/**/*.json -text
*.png binary
*.ogg binary
*.nbt binary
